:root{
    --bg: #0A0D13;
    --bg-raised: #10141C;
    --bg-panel: #131824;
    --lattice: rgba(160, 180, 220, 0.08);
    --lattice-strong: rgba(160, 180, 220, 0.16);
    --ink: #E9ECF3;
    --ink-dim: #8D95A8;
    --ink-faint: #565E70;
    --energy: #FF6A3D;
    --energy-soft: rgba(255, 106, 61, 0.14);
    --velocity: #3ED7C8;
    --velocity-soft: rgba(62, 215, 200, 0.14);
    --glow-a: #7CFFC4;
    --line: rgba(233, 236, 243, 0.10);
    --line-strong: rgba(233, 236, 243, 0.18);
    --radius: 3px;
    --serif-num: "IBM Plex Mono", monospace;
    --display: "Space Grotesk", sans-serif;
    --body: "IBM Plex Sans", sans-serif;
  }

  *{ box-sizing: border-box; margin:0; padding:0; }

  html{ scroll-behavior: smooth; }

  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior: auto; }
    *{ animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
  }

  body{
    background-color: var(--bg);
    color: var(--ink);
    font-family: var(--body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    background-image:
      repeating-radial-gradient(circle at 0 0, transparent 0, var(--bg) 12px),
      repeating-linear-gradient(rgba(124,255,196,0.05), rgba(62,215,200,0.07));
  }

  a{ color: inherit; }

  ::selection{ background: var(--energy); color: #0A0D13; }

  :focus-visible{
    outline: 2px solid var(--velocity);
    outline-offset: 3px;
  }

  .wrap{
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ---------- NAV ---------- */
  header.site-nav{
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10,13,19,0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner{
    max-width: 1120px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark{
    font-family: var(--display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .wordmark .dot{
    width: 9px; height: 9px;
    border-radius: 60% 40% 55% 45%;
    background: linear-gradient(135deg, var(--energy), var(--velocity));
    display: inline-block;
    flex-shrink: 0;
  }
  nav.links{
    display: flex;
    gap: 28px;
    font-family: var(--serif-num);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  nav.links a{
    text-decoration: none;
    color: var(--ink-dim);
    transition: color 0.2s ease;
    white-space: nowrap;
  }
  nav.links a:hover{ color: var(--ink); }
  @media (max-width: 760px){
    nav.links{ display: none; }
  }

  /* ---------- HERO ---------- */
  .hero{
    padding: 110px 0 90px;
    position: relative;
    overflow: hidden;
  }
  .hero-inner{
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
  }
  @media (max-width: 860px){
    .hero-inner{ grid-template-columns: 1fr; }
  }

  .eyebrow{
    font-family: var(--serif-num);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--energy);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }
  .eyebrow::before{
    content: "";
    width: 22px; height: 1px;
    background: var(--energy);
  }

  h1.thesis{
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 26px;
  }
  h1.thesis em{
    font-style: normal;
    color: var(--velocity);
  }

  .hero p.sub{
    font-size: 17px;
    color: var(--ink-dim);
    max-width: 46ch;
    margin-bottom: 34px;
  }

  .cta-row{ display: flex; gap: 14px; flex-wrap: wrap; }
  .btn{
    position: relative;
    font-family: var(--serif-num);
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 13px 26px;
    border-radius: 6em;
    text-decoration: none;
    display: inline-block;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    border: 1px solid transparent;
    overflow: visible;
    z-index: 0;
  }
  .btn::after{
    content: "";
    display: block;
    position: absolute;
    inset: 0;
    border-radius: 6em;
    z-index: -1;
    opacity: 0;
    transition: transform 0.4s ease, opacity 0.4s ease, background 0.2s ease;
  }
  .btn:hover{
    transform: translateY(-3px);
  }
  .btn:active{
    transform: translateY(-1px);
  }
  .btn-primary{
    background: var(--ink);
    color: var(--bg);
    transition: transform 0.2s ease, box-shadow 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .btn-primary::after{ background: var(--velocity); }
  .btn-primary:hover{
    background: var(--velocity);
    color: var(--bg);
    box-shadow: 0 10px 26px rgba(62,215,200,0.35);
  }
  .btn-primary:hover::after{
    animation: btn-ripple 0.6s ease-out;
  }
  @keyframes btn-ripple{
    0%{ opacity: 0.9; transform: scale(1); }
    100%{ opacity: 0; transform: scale(1.5); }
  }
  .btn-ghost{
    background: transparent;
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .btn-ghost::after{ content: none; }
  .btn-ghost:hover{
    border-color: var(--energy);
    color: var(--energy);
    box-shadow: 0 10px 26px rgba(255,106,61,0.2);
  }

  /* droplet visual */
  .droplet-stage{
    position: relative;
    height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lattice-frame{
    position: absolute;
    inset: 0;
    border: 1px solid var(--line);
    background-image:
      linear-gradient(var(--lattice-strong) 1px, transparent 1px),
      linear-gradient(90deg, var(--lattice-strong) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(circle at center, black 40%, transparent 78%);
  }
  .droplet-halo{
    position: absolute;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: linear-gradient(45deg, var(--glow-a), var(--velocity), #1FFFA3, var(--glow-a));
    background-size: 300% 300%;
    filter: blur(30px);
    opacity: 0.6;
    z-index: 1;
    animation: halo-spin 8s linear infinite;
  }
  @keyframes halo-spin{
    0%{ background-position: 0% 50%; }
    50%{ background-position: 100% 50%; }
    100%{ background-position: 0% 50%; }
  }

  .metaball-collapse-wrap{
    position: absolute;
    width: 210px;
    height: 210px;
    z-index: 2;
    overflow: hidden;
    border-radius: 50%;
    background: black;
    filter: contrast(25);
    transition: transform 0.5s cubic-bezier(.4,0,.2,1), opacity 0.5s ease;
  }
  .metaball-collapse-wrap.is-collapsing{
    transform: scale(0.15);
    opacity: 0.2;
  }
  .metaball-stage{
    background: inherit;
    animation: metaball-spin 7s ease-in-out infinite;
  }
  @keyframes metaball-spin{
    to{ transform: rotate(360deg); }
  }
  .meta:before,
  .meta:after{
    content: "";
    position: absolute;
    width: 100px;
    height: 100px;
    left: 50%;
    top: 50%;
    margin: -50px;
    background: rgba(124,255,196,.9);
    border-radius: 50%;
    filter: blur(25px);
    animation: meta-move 12s infinite alternate ease-in-out;
  }
  .meta:before{
    animation-duration: 19.3s;
    animation-delay: -3.3s;
  }
  .meta:nth-child(2):before{
    animation-duration: 14.7s;
    animation-delay: -2.7s;
  }
  .meta:nth-child(2):after{
    animation-duration: 8.7s;
    animation-delay: -5.32s;
  }
  @keyframes meta-move{
    0%{ transform: translate(0%, 100%); }
    15%{ transform: translate(-120%, 160%); }
    30%{ transform: translate(100%, -80%); }
    40%{ transform: translate(-140%, 0%); }
    60%{ transform: translate(40%, -80%); }
    80%{ transform: translate(-160%, -20%); }
    100%{ transform: translate(40%, 60%); }
  }

  .droplet-label{
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--serif-num);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    text-transform: uppercase;
  }

  /* ---------- SECTION SHELL ---------- */
  section{
    padding: 88px 0;
    border-top: 1px solid var(--line);
  }
  .section-head{
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 46px;
    flex-wrap: wrap;
  }
  .section-tag{
    font-family: var(--serif-num);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--velocity);
  }
  h2{
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(24px, 3vw, 34px);
    letter-spacing: -0.01em;
    margin-top: 8px;
  }
  .lede{
    font-size: 16.5px;
    color: var(--ink-dim);
    max-width: 62ch;
    margin-bottom: 20px;
  }

  /* ---------- WHAT IS DDI ---------- */
  .concept-grid{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }
  @media (max-width: 820px){ .concept-grid{ grid-template-columns: 1fr; } }
  .concept-grid p{ color: var(--ink-dim); margin-bottom: 16px; font-size: 15.5px; }
  .concept-grid p strong{ color: var(--ink); font-weight: 500; }
  .pull-note{
    font-family: var(--serif-num);
    font-size: 15px;
    color: var(--ink);
    border-left: 2px solid var(--energy);
    padding: 4px 0 4px 20px;
    margin-top: 20px;
    line-height: 1.7;
  }

  /* comparison panel */
  .compare-panel{
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
  }
  .compare-row{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .compare-row:last-child{ border-bottom: none; }
  .compare-row .metric-name{
    font-family: var(--serif-num);
    font-size: 13.5px;
    color: var(--ink-dim);
  }
  .compare-row .metric-q{
    font-size: 14px;
    color: var(--ink);
  }
  .compare-head{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    padding-bottom: 14px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--serif-num);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .compare-row.ddi-row .metric-q{ color: var(--velocity); }
  .compare-row.ddi-row .metric-name{ color: var(--velocity); }

  /* ---------- METHODOLOGY ---------- */
  .component-card{
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 32px;
    padding: 40px 0;
    border-top: 1px solid var(--line);
  }
  .component-card:first-of-type{ border-top: none; }
  @media (max-width: 700px){
    .component-card{ grid-template-columns: 1fr; gap: 14px; }
  }
  .comp-index{
    font-family: var(--serif-num);
    font-size: 13px;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
  }
  .comp-index .num{
    display: block;
    font-size: 40px;
    color: var(--ink);
    font-weight: 500;
    line-height: 1;
    margin-bottom: 6px;
  }
  .comp-body h3{
    font-family: var(--display);
    font-size: 21px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .comp-body > p.what{
    color: var(--ink-dim);
    font-size: 15px;
    margin-bottom: 20px;
    max-width: 64ch;
  }
  table.inputs{
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
    font-size: 13.5px;
  }
  table.inputs th{
    text-align: left;
    font-family: var(--serif-num);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding: 8px 14px 8px 0;
    border-bottom: 1px solid var(--line-strong);
  }
  table.inputs td{
    padding: 12px 14px 12px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-dim);
    vertical-align: top;
  }
  table.inputs td:first-child{ color: var(--ink); }

  .scoring-guide{
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .scoring-guide .chip{
    font-family: var(--serif-num);
    font-size: 12px;
    padding: 8px 12px;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    color: var(--ink-dim);
    flex: 1 1 220px;
  }
  .scoring-guide .chip b{ color: var(--ink); }

  /* formula display */
  .formula-block{
    margin: 70px 0 60px;
    text-align: center;
    padding: 54px 20px;
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    position: relative;
  }
  .formula-block .formula{
    font-family: var(--serif-num);
    font-size: clamp(20px, 4.2vw, 34px);
    letter-spacing: 0.01em;
  }
  .formula-block .formula .e{ color: var(--energy); }
  .formula-block .formula .v{ color: var(--velocity); }
  .formula-block .example{
    margin-top: 18px;
    font-family: var(--serif-num);
    font-size: 14px;
    color: var(--ink-faint);
  }

  /* interpretation table */
  table.interp{
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  table.interp th{
    text-align: left;
    font-family: var(--serif-num);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding: 10px 16px 10px 0;
    border-bottom: 1px solid var(--line-strong);
  }
  table.interp td{
    padding: 18px 16px 18px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    color: var(--ink-dim);
  }
  table.interp td.range{
    font-family: var(--serif-num);
    color: var(--ink);
    white-space: nowrap;
  }
  table.interp td.state{
    font-family: var(--serif-num);
    font-size: 12.5px;
    letter-spacing: 0.03em;
  }
  .state-tag{
    display: inline-block;
    padding: 3px 9px;
    border-radius: var(--radius);
    font-size: 11.5px;
  }
  .state-sub{ background: var(--velocity-soft); color: var(--velocity); }
  .state-trans{ background: rgba(233,236,243,0.08); color: var(--ink); }
  .state-drop{ background: var(--energy-soft); color: var(--energy); }
  .state-crit{ background: rgba(255,106,61,0.22); color: #FF9270; }

  /* ---------- APPLIED / CASE STUDIES ---------- */
  .illustrative-note{
    font-family: var(--serif-num);
    font-size: 12.5px;
    color: var(--ink-faint);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    padding: 14px 18px;
    margin-bottom: 40px;
    line-height: 1.7;
  }
  .illustrative-note b{ color: var(--ink-dim); }

  .scroll-cue{
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--serif-num);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--velocity);
    margin-bottom: 28px;
    transition: opacity 0.4s ease;
  }
  .scroll-cue svg{
    animation: scroll-cue-bounce 1.6s ease-in-out infinite;
  }
  @keyframes scroll-cue-bounce{
    0%, 100%{ transform: translateY(0); opacity: 0.6; }
    50%{ transform: translateY(4px); opacity: 1; }
  }

  .case-grid{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 24px;
  }
  .case-card{
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    max-height: 232px;
    transition: max-height 0.55s ease, transform 0.25s ease, border-color 0.25s ease;
  }
  .case-card:hover{
    max-height: 900px;
    transform: translateY(-4px);
    border-color: var(--line-strong);
  }
  .teaser-hint{
    display: block;
    margin-top: 14px;
    font-family: var(--serif-num);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
    opacity: 1;
    transition: opacity 0.25s ease;
  }
  .case-card:hover .teaser-hint{
    opacity: 0;
  }
  .case-reveal{
    margin-top: 20px;
    opacity: 0;
    transition: opacity 0.4s ease 0.1s;
  }
  .case-card:hover .case-reveal{
    opacity: 1;
  }
  .case-card--empty{
    background: transparent;
    border: 1px dashed var(--line-strong);
    justify-content: center;
    min-height: 220px;
    max-height: none;
    cursor: default;
  }
  .case-card--empty:hover{
    transform: none;
    border-color: var(--line-strong);
    box-shadow: none;
  }
  .case-card--empty h3{ color: var(--ink-faint); }
  .case-card--empty .case-sector{ color: var(--ink-faint); }
  .empty-slot-body p{
    font-size: 13.5px;
    color: var(--ink-faint);
    line-height: 1.6;
  }
  .case-top{
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 6px;
  }
  .case-top h3{
    margin-bottom: 6px;
  }
  .case-logo{
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: var(--radius);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    padding: 6px;
    flex-shrink: 0;
  }
  .case-logo-fallback{
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background: linear-gradient(150deg, var(--energy), var(--velocity) 130%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--display);
    font-weight: 700;
    font-size: 15px;
    color: #0A0D13;
    flex-shrink: 0;
  }
  .case-card h3{
    font-family: var(--display);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }
  .case-sector{
    font-family: var(--serif-num);
    font-size: 11.5px;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .illustrative-badge{
    display: inline-block;
    margin-left: 8px;
    padding: 2px 7px;
    border-radius: var(--radius);
    background: rgba(233,236,243,0.08);
    color: var(--ink-dim);
    font-size: 10px;
    letter-spacing: 0.04em;
  }
  .case-headline{
    font-family: var(--display);
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.4;
    margin: 18px 0 10px;
  }
  .case-body{
    font-size: 14px;
    color: var(--ink-dim);
    line-height: 1.65;
    margin-bottom: 20px;
  }
  .case-conclusion{
    font-size: 14px;
    color: var(--ink-dim);
    line-height: 1.65;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .case-conclusion strong{
    display: block;
    font-family: var(--serif-num);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--velocity);
    margin-bottom: 6px;
  }
  .case-scores{
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
  }
  .score-row{
    display: grid;
    grid-template-columns: 40px 1fr 28px;
    align-items: center;
    gap: 10px;
    font-family: var(--serif-num);
    font-size: 12px;
  }
  .score-row .label{ color: var(--ink-faint); }
  .score-row .bar-track{
    height: 5px;
    background: rgba(233,236,243,0.08);
    border-radius: 3px;
    overflow: hidden;
    display: block;
  }
  .score-row .bar-fill{ display: block; height: 100%; border-radius: 3px; }
  .score-row.ads .bar-fill{ background: var(--energy); }
  .score-row.ows .bar-fill{ background: #FFB199; }
  .score-row.rvs .bar-fill{ background: var(--velocity); }
  .score-row .value{ text-align: right; color: var(--ink); }

  .ddi-readout{
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    margin-bottom: 16px;
  }
  .ddi-readout .ddi-number{
    font-family: var(--serif-num);
    font-size: 30px;
    color: var(--ink);
    font-weight: 500;
  }
  .ddi-readout .ddi-caption{
    font-family: var(--serif-num);
    font-size: 10.5px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .case-card p.observation{
    font-size: 14px;
    color: var(--ink-dim);
    line-height: 1.65;
  }

  /* live feed panel */
  .feed-panel{
    margin-top: 56px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-panel);
    padding: 26px 28px;
  }
  .feed-head{
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    font-family: var(--serif-num);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .feed-head .pulse{
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--ink-faint);
    flex-shrink: 0;
  }
  .feed-table{ width: 100%; border-collapse: collapse; font-size: 13px; }
  .feed-table td{ padding: 9px 0; border-bottom: 1px solid var(--line); color: var(--ink-dim); }
  .feed-table td:first-child{ color: var(--ink); width: 40%; }
  .feed-table td.status{ text-align: right; font-family: var(--serif-num); font-size: 11px; letter-spacing: 0.04em; }
  .feed-table td.status.live{ color: var(--velocity); }
  .feed-table td.status.manual{ color: var(--ink-faint); }

  /* ---------- PRACTICAL USE ---------- */
  .use-grid{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
  }
  .use-card{
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }
  .use-card .use-mark{
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    margin-bottom: 16px;
  }
  .use-card h4{
    font-family: var(--display);
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 10px;
    line-height: 1.3;
  }
  .use-card p{
    font-size: 14px;
    color: var(--ink-dim);
    line-height: 1.65;
  }

  /* ---------- ABOUT ---------- */
  .about-grid{
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 700px){ .about-grid{ grid-template-columns: 1fr; } }
  .photo-frame{
    width: 168px;
    height: 168px;
    border-radius: var(--radius);
    object-fit: cover;
    display: block;
  }
  .photo-frame--placeholder{
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-panel);
    border: 1px dashed var(--line-strong);
    font-family: var(--serif-num);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-align: center;
    line-height: 1.6;
  }
  .about-copy p{
    color: var(--ink-dim);
    margin-bottom: 16px;
    font-size: 15.5px;
    max-width: 60ch;
  }
  .about-copy p strong{ color: var(--ink); font-weight: 500; }
  .contact-line{
    display: flex;
    gap: 24px;
    margin-top: 22px;
    font-family: var(--serif-num);
    font-size: 13px;
    flex-wrap: wrap;
  }
  .contact-line a{ color: var(--velocity); text-decoration: none; border-bottom: 1px solid transparent; }
  .contact-line a:hover{ border-bottom-color: var(--velocity); }

  /* ---------- LEGAL / PROPRIETARY NOTICE ---------- */
  .legal-panel{
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 40px;
    background:
      repeating-linear-gradient(135deg, rgba(233,236,243,0.02) 0px, rgba(233,236,243,0.02) 1px, transparent 1px, transparent 14px),
      var(--bg-panel);
  }
  .legal-panel h3{
    font-family: var(--serif-num);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--energy);
    margin-bottom: 10px;
    margin-top: 26px;
  }
  .legal-panel h3:first-child{ margin-top: 0; }
  .legal-panel p{
    font-size: 14.5px;
    color: var(--ink-dim);
    line-height: 1.75;
    max-width: 72ch;
  }
  .legal-panel p strong{ color: var(--ink); font-weight: 500; }
  .legal-disclaimer-note{
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px dashed var(--line-strong);
    font-family: var(--serif-num);
    font-size: 11.5px;
    color: var(--ink-faint);
    line-height: 1.7;
  }

  /* ---------- FOOTER ---------- */
  footer{
    padding: 50px 0 60px;
    border-top: 1px solid var(--line);
  }
  .footer-inner{
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-inner .wordmark{ font-size: 15px; }
  footer p{
    font-family: var(--serif-num);
    font-size: 12px;
    color: var(--ink-faint);
  }

/* ============================================================
   SHOWCASE STACK — scroll-driven card deck
   Uses DDI tokens: --bg, --bg-panel, --ink, --energy, --velocity,
   --line, --serif-num, --display
   ============================================================ */

.showcase {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
  border-top: none !important;
  padding: 0 !important;
}

.showcase__backgrounds { position: absolute; inset: 0; z-index: 0; }

.showcase__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  opacity: 0;
  will-change: opacity;
}

.showcase__stack {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 2;
  will-change: transform;
}

.showcase-card {
  position: absolute;
  top: 50%; left: 50%;
  width: 96%;
  max-width: 1180px;
  height: 88%;
  max-height: 640px;
  padding: 24px;
  transform: translate(-50%, -50%);
  transform-origin: center center;
  background: var(--bg-panel);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  will-change: transform, background-color;
  backface-visibility: hidden;
}
.showcase-card:nth-child(1) { z-index: 16; }
.showcase-card:nth-child(2) { z-index: 15; }
.showcase-card:nth-child(3) { z-index: 14; }
.showcase-card:nth-child(4) { z-index: 13; }
.showcase-card:nth-child(5) { z-index: 12; }
.showcase-card:nth-child(6) { z-index: 11; }
.showcase-card:nth-child(7) { z-index: 10; }

.showcase-card__grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr 1fr;
  gap: 20px;
  height: 100%;
}
.showcase-card__col { min-height: 0; }

.showcase-card__col--text {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 8px 0 0;
}
.showcase-card__heading {
  font-family: var(--display);
  font-weight: 600;
  font-size: clamp(20px, 2.2vw, 34px);
  line-height: 1.08;
  letter-spacing: -0.01em;
  color: var(--ink);
  margin: 0;
}
.showcase-card__brand {
  display: flex;
  align-items: center;
  gap: 10px;
  border-top: 1px solid var(--line);
  padding-top: 14px;
  font-family: var(--serif-num);
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-dim);
}
.showcase-card__brand-dot {
  width: 9px; height: 9px;
  border-radius: 60% 40% 55% 45%;
  background: linear-gradient(135deg, var(--energy), var(--velocity));
  flex-shrink: 0;
}

.showcase-card__col--score {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  background: var(--bg-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  padding: 24px;
}
.showcase-card__col--score::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--lattice-strong) 1px, transparent 1px),
    linear-gradient(90deg, var(--lattice-strong) 1px, transparent 1px);
  background-size: 24px 24px;
  mask-image: radial-gradient(circle at center, black 30%, transparent 70%);
  pointer-events: none;
  opacity: 0.6;
}
.showcase-card__index {
  position: absolute;
  top: 16px; left: 16px;
  font-family: var(--serif-num);
  font-size: 11px;
  letter-spacing: 0.08em;
  color: var(--ink-faint);
  z-index: 2;
}
.showcase-card__logo-stage {
  position: relative;
  z-index: 2;
  width: 80px; height: 80px;
  margin-bottom: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 10px;
}
.showcase-card__logo-stage img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}
.showcase-card__logo-fallback {
  width: 100%; height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--display);
  font-weight: 700;
  font-size: 22px;
  color: var(--bg);
  background: linear-gradient(150deg, var(--energy), var(--velocity) 130%);
  border-radius: calc(var(--radius) - 1px);
}
.showcase-card__score {
  position: relative;
  z-index: 2;
  font-family: var(--serif-num);
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 500;
  line-height: 1;
  color: var(--ink);
  letter-spacing: -0.02em;
}
.showcase-card__score-label {
  position: relative;
  z-index: 2;
  font-family: var(--serif-num);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-top: 8px;
  margin-bottom: 14px;
}

.showcase-card__col--details {
  display: flex;
  flex-direction: column;
  padding: 8px 0 0;
}
.showcase-card__title {
  font-family: var(--display);
  font-weight: 600;
  font-size: 18px;
  line-height: 1.15;
  letter-spacing: -0.01em;
  color: var(--ink);
  margin: 0 0 12px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}
.showcase-card__desc {
  font-size: 13.5px;
  line-height: 1.55;
  color: var(--ink-dim);
  margin: 0 0 18px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.showcase-card__bars {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 18px;
}
.showcase-card__bar {
  display: grid;
  grid-template-columns: 34px 1fr 26px;
  align-items: center;
  gap: 10px;
  font-family: var(--serif-num);
  font-size: 11px;
}
.showcase-card__bar-label { color: var(--ink-faint); letter-spacing: 0.04em; }
.showcase-card__bar-track {
  height: 4px;
  background: rgba(233, 236, 243, 0.08);
  border-radius: 2px;
  overflow: hidden;
  display: block;
}
.showcase-card__bar-fill { display: block; height: 100%; border-radius: 2px; }
.showcase-card__bar--ads .showcase-card__bar-fill { background: var(--energy); }
.showcase-card__bar--ows .showcase-card__bar-fill { background: #FFB199; }
.showcase-card__bar--rvs .showcase-card__bar-fill { background: var(--velocity); }
.showcase-card__bar-value { color: var(--ink); text-align: right; }

.showcase-card__actions {
  display: flex;
  gap: 8px;
  margin-top: auto;
}
.showcase-card__btn {
  font-family: var(--serif-num);
  font-size: 11.5px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 12px 14px;
  border-radius: var(--radius);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid transparent;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}
.showcase-card__btn--primary {
  flex: 1;
  background: var(--ink);
  color: var(--bg);
}
.showcase-card__btn--primary:hover {
  background: var(--velocity);
  color: var(--bg);
}
.showcase-card__btn--ghost {
  border-color: var(--line-strong);
  color: var(--ink);
  width: 48px;
}
.showcase-card__btn--ghost:hover {
  border-color: var(--energy);
  color: var(--energy);
}

.showcase-nav {
  position: fixed;
  top: 90px; right: 40px;
  display: flex;
  gap: 6px;
  padding: 8px;
  border-radius: var(--radius);
  background: rgba(19, 24, 36, 0.8);
  border: 1px solid var(--line);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.showcase-nav__thumb {
  width: 40px; height: 40px;
  padding: 0;
  border: 1px solid transparent;
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--bg-raised);
  cursor: pointer;
  opacity: 0.5;
  transition: opacity 0.25s ease, border-color 0.25s ease;
  font-family: var(--serif-num);
  font-size: 11px;
  color: var(--ink-dim);
  display: flex;
  align-items: center;
  justify-content: center;
}
.showcase-nav__thumb:hover,
.showcase-nav__thumb.is-active {
  opacity: 1;
  border-color: var(--line-strong);
  color: var(--ink);
}

@media (prefers-reduced-motion: reduce) {
  .showcase { height: auto; padding: 40px 0 !important; }
  .showcase__stack { height: auto; }
  .showcase-card {
    position: relative;
    top: auto; left: auto;
    transform: none;
    margin-bottom: 24px;
    height: auto;
    max-height: none;
  }
  .showcase-nav { display: none; }
}

@media (max-width: 860px) {
  .showcase { height: auto; padding: 40px 20px !important; }
  .showcase__stack { height: auto; }
  .showcase-card {
    position: relative;
    top: auto; left: auto;
    transform: none;
    width: 100%;
    max-height: none;
    margin-bottom: 20px;
    padding: 20px;
  }
  .showcase-card__grid { grid-template-columns: 1fr; gap: 16px; }
  .showcase-card__col--score { padding: 32px 20px; }
  .showcase-nav { display: none; }
}
/* ══════════════════════════════════════════════════════════════
   SHOWCASE — INLINE VARIANT
   Sits inside the #ratings section instead of full-viewport.
   ══════════════════════════════════════════════════════════════ */

.showcase.showcase--inline {
  height: auto;
  min-height: 640px;
  padding: 0;
  margin: 0 0 40px;
  border-top: none;
  overflow: visible;
  background: transparent;
  position: relative;
}

.showcase.showcase--inline .showcase__stack {
  position: relative;
  width: 100%;
  height: 640px;
  z-index: 2;
}

.showcase.showcase--inline .showcase-card {
  width: 100%;
  max-width: 100%;
  height: 100%;
  max-height: 640px;
  padding: 24px;
  background: var(--bg-panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
}

@media (max-width: 860px) {
  .showcase.showcase--inline { min-height: 0; }
  .showcase.showcase--inline .showcase__stack { height: auto; }
  .showcase.showcase--inline .showcase-card {
    position: relative;
    top: auto; left: auto;
    transform: none;
    height: auto;
    max-height: none;
    margin-bottom: 16px;
  }
}