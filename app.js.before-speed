function calculateDDI(ads, ows, rvs) {
  return (ads * ows) / rvs;
}


function getState(ddi) {

  if (ddi < 2.0)
    return { label: "Sub-Dropleton", tag: "state-sub" };

  if (ddi < 5.0)
    return { label: "Transitional", tag: "state-trans" };

  if (ddi < 8.0)
    return { label: "Dropleton State", tag: "state-drop" };

  return {
    label: "Critical Dropleton",
    tag: "state-crit"
  };

}



function scoreBarWidth(score) {

  return Math.max(
    0,
    Math.min(100, score * 10)
  ) + "%";

}



function getInitials(name) {

  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0,2)
    .map(w => w[0].toUpperCase())
    .join("");

}



function slugify(name) {

  return name
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g,"-")
    .replace(/(^-|-$)/g,"");

}




function buildCompanyCard(company) {


  const ddi = calculateDDI(
    company.ads,
    company.ows,
    company.rvs
  );


  const state = getState(ddi);


  const hasLogo =
    company.logo &&
    company.logo.trim() !== "";



  const card = document.createElement("a");


  card.className = "case-card";


  card.href =
    `company.html?c=${encodeURIComponent(slugify(company.name))}`;



  card.innerHTML = `


    <span class="card-glow"></span>


    <div class="case-content">



      <div class="case-dots">

        <span 
        class="dot-ads"
        title="Asset Density Score: ${company.ads}">
        </span>


        <span 
        class="dot-ows"
        title="Opportunity Window Score: ${company.ows}">
        </span>


        <span 
        class="dot-rvs"
        title="Response Velocity Score: ${company.rvs}">
        </span>


      </div>




      <div class="case-top">


        ${
          hasLogo

          ?

          `<img 
          class="case-logo"
          src="${company.logo}"
          alt="${company.name} logo">`

          :

          `<div class="case-logo-fallback">
          ${getInitials(company.name)}
          </div>`

        }



        <div>


          <h3>
            ${company.name}
          </h3>



          <span class="state-tag ${state.tag}">
            ${state.label}
          </span>


        </div>


      </div>




      <span class="teaser-hint">
        Hover for full rating â†“
      </span>





      <div class="case-reveal">


        <div class="case-sector">


          ${company.sector}


          ${
            company.illustrative

            ?

            `<span class="illustrative-badge">
            Composite Example
            </span>`

            :

            ""

          }


        </div>





        <p class="case-headline">
          ${company.headline}
        </p>



        <p class="case-body">
          ${company.body}
        </p>






        <div class="case-scores">



          <div class="score-row ads">


            <span class="label">
              ADS
            </span>


            <span class="bar-track">

              <span 
              class="bar-fill"
              style="width:${scoreBarWidth(company.ads)}">
              </span>

            </span>


            <span class="value">
              ${company.ads}
            </span>


          </div>






          <div class="score-row ows">


            <span class="label">
              OWS
            </span>


            <span class="bar-track">


              <span
              class="bar-fill"
              style="width:${scoreBarWidth(company.ows)}">
              </span>


            </span>


            <span class="value">
              ${company.ows}
            </span>


          </div>






          <div class="score-row rvs">


            <span class="label">
              RVS
            </span>



            <span class="bar-track">


              <span
              class="bar-fill"
              style="width:${scoreBarWidth(company.rvs)}">
              </span>


            </span>


            <span class="value">
              ${company.rvs}
            </span>


          </div>



        </div>






        <div class="ddi-readout">


          <span class="ddi-number">
            ${ddi.toFixed(1)}
          </span>



          <span class="ddi-caption">


            <span class="state-tag ${state.tag}">
              ${state.label}
            </span>


          </span>



        </div>







        <p class="case-conclusion">

          <strong>
            Conclusion
          </strong>

          <br>

          ${company.conclusion}


        </p>




      </div>




    </div>


  `;




  const logoImg =
    card.querySelector(".case-logo");



  if (logoImg) {


    logoImg.addEventListener(
      "error",
      () => {


        const fallback =
        document.createElement("div");



        fallback.className =
        "case-logo-fallback";



        fallback.textContent =
        getInitials(company.name);



        logoImg.replaceWith(fallback);


      }
    );


  }



  return card;


}






function renderCompanies() {


  const grid =
  document.getElementById("case-grid");



  if (!grid)
    return;



  grid.innerHTML = "";



  companies.forEach(
    company =>
    grid.appendChild(
      buildCompanyCard(company)
    )
  );






  const cueText =
  document.getElementById("scroll-cue-text");



  const cue =
  document.getElementById("scroll-cue");




  if (cueText) {


    const count =
    companies.length;



    cueText.textContent =
    count === 1

    ?

    "1 company rated â€” scroll to see it"

    :

    `${count} companies rated â€” scroll to see all`;


  }





  if (cue) {


    const hideCue = () => {


      cue.style.opacity = "0";


      window.removeEventListener(
        "scroll",
        hideCue
      );


    };



    window.addEventListener(
      "scroll",
      hideCue,
      {
        passive:true
      }
    );


  }



}






document.addEventListener(
  "DOMContentLoaded",
  renderCompanies
);


/* ==========================================================================
   SHOWCASE STACK â€” scroll-driven card deck
   Runs alongside the existing case-grid; reuses companies[] and helpers.
   ========================================================================== */

function buildShowcaseCard(company, index) {
  const ddi = calculateDDI(company.ads, company.ows, company.rvs);
  const state = getState(ddi);
  const hasLogo = company.logo && company.logo.trim() !== "";
  const num = String(index + 1).padStart(2, "0");

  const card = document.createElement("article");
  card.className = "showcase-card";
  card.dataset.state = state.tag;
  card.dataset.index = index;

  card.innerHTML = [
    '<div class="showcase-card__grid">',
    '  <div class="showcase-card__col showcase-card__col--text">',
    '    <h2 class="showcase-card__heading">' + company.headline + '</h2>',
    '    <div class="showcase-card__brand">',
    '      <span class="showcase-card__brand-dot"></span>',
    '      <span>' + company.name + '</span>',
    '    </div>',
    '  </div>',
    '  <div class="showcase-card__col showcase-card__col--score">',
    '    <span class="showcase-card__index">' + num + ' / 0' + companies.length + '</span>',
    '    <div class="showcase-card__logo-stage">',
    (hasLogo
      ? '      <img src="' + company.logo + '" alt="' + company.name + ' logo">'
      : '      <div class="showcase-card__logo-fallback">' + getInitials(company.name) + '</div>'
    ),
    '    </div>',
    '    <div class="showcase-card__score">' + ddi.toFixed(1) + '</div>',
    '    <div class="showcase-card__score-label">DDI Score</div>',
    '    <span class="state-tag ' + state.tag + '">' + state.label + '</span>',
    '  </div>',
    '  <div class="showcase-card__col showcase-card__col--details">',
    '    <h3 class="showcase-card__title">' + company.name + '</h3>',
    '    <p class="showcase-card__desc">' + company.body.replace(/<[^>]+>/g, "").slice(0, 220) + 'â€¦</p>',
    '    <div class="showcase-card__bars">',
    '      <div class="showcase-card__bar showcase-card__bar--ads">',
    '        <span class="showcase-card__bar-label">ADS</span>',
    '        <span class="showcase-card__bar-track"><span class="showcase-card__bar-fill" style="width:' + scoreBarWidth(company.ads) + '"></span></span>',
    '        <span class="showcase-card__bar-value">' + company.ads + '</span>',
    '      </div>',
    '      <div class="showcase-card__bar showcase-card__bar--ows">',
    '        <span class="showcase-card__bar-label">OWS</span>',
    '        <span class="showcase-card__bar-track"><span class="showcase-card__bar-fill" style="width:' + scoreBarWidth(company.ows) + '"></span></span>',
    '        <span class="showcase-card__bar-value">' + company.ows + '</span>',
    '      </div>',
    '      <div class="showcase-card__bar showcase-card__bar--rvs">',
    '        <span class="showcase-card__bar-label">RVS</span>',
    '        <span class="showcase-card__bar-track"><span class="showcase-card__bar-fill" style="width:' + scoreBarWidth(company.rvs) + '"></span></span>',
    '        <span class="showcase-card__bar-value">' + company.rvs + '</span>',
    '      </div>',
    '    </div>',
    '    <div class="showcase-card__actions">',
    '      <a class="showcase-card__btn showcase-card__btn--primary" href="company.html?c=' + encodeURIComponent(slugify(company.name)) + '">View Full Report</a>',
    '      <a class="showcase-card__btn showcase-card__btn--ghost" href="company.html?c=' + encodeURIComponent(slugify(company.name)) + '" aria-label="Open report">â†—</a>',
    '    </div>',
    '  </div>',
    '</div>'
  ].join("\n");

  const img = card.querySelector(".showcase-card__logo-stage img");
  if (img) {
    img.addEventListener("error", () => {
      img.replaceWith(Object.assign(document.createElement("div"), {
        className: "showcase-card__logo-fallback",
        textContent: getInitials(company.name)
      }));
    });
  }

  return card;
}


function initShowcase() {
  const section = document.getElementById("showcase");
  const stack = document.getElementById("showcase-stack");
  const navWidget = document.getElementById("showcase-nav");
  if (!section || !stack) return;

  stack.innerHTML = "";
  companies.forEach((c, i) => stack.appendChild(buildShowcaseCard(c, i)));

  const cards = Array.from(stack.querySelectorAll(".showcase-card"));

  if (navWidget) {
    navWidget.innerHTML = "";
    cards.forEach((_, i) => {
      const btn = document.createElement("button");
      btn.className = "showcase-nav__thumb";
      btn.type = "button";
      btn.textContent = String(i + 1).padStart(2, "0");
      navWidget.appendChild(btn);
    });
  }
  const navThumbs = navWidget ? Array.from(navWidget.querySelectorAll(".showcase-nav__thumb")) : [];

  if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined") {
    console.warn("GSAP not loaded â€” showcase renders as plain stacked list.");
    return;
  }

  gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

  const TOTAL = cards.length;
  if (TOTAL < 2) return;

  const INITIAL_DELAY = 0.3;
  const END_DELAY     = 0.3;
  const CARD_DURATION = 1.4;
  const STACK_COLORS = [
    "#1F1E21",
    "#2E2E30",
    "#3C3C3F",
    "#4B4A4E",
    "#59585D",
    "#68676C",
    "#77767A"
  ];
  const CARD_TOP_COLOR = "#0D0B14";
  const SCROLL_END    = window.innerHeight * (TOTAL - 1);

  const overlays = Array.from(section.querySelectorAll(".showcase__bg"));
  const stateColors = {
    "state-sub":   "#3ED7C8",
    "state-trans": "#8D95A8",
    "state-drop":  "#FF6A3D",
    "state-crit":  "#FF9270"
  };
  let activeOverlay = 0;

  function setBg(index) {
    if (overlays.length < 2) return;
    const card = cards[index];
    if (!card) return;
    const color = stateColors[card.dataset.state] || "#131824";
    const next = (activeOverlay + 1) % overlays.length;
    overlays[next].style.backgroundColor = color;
    gsap.set(overlays[next], { opacity: 0 });
    gsap.to(overlays[next],          { opacity: 0.22, duration: 0.6, ease: "power1.inOut" });
    gsap.to(overlays[activeOverlay], { opacity: 0,    duration: 0.6, ease: "power1.inOut",
      onComplete: () => { activeOverlay = next; }
    });
  }

  if (overlays[0]) {
    overlays[0].style.backgroundColor = stateColors[cards[0].dataset.state] || "#131824";
    gsap.set(overlays[0], { opacity: 0.22 });
    gsap.set(overlays[1], { opacity: 0 });
  }

  function setActiveThumb(i) {
    navThumbs.forEach((btn, n) => btn.classList.toggle("is-active", n === i));
  }

  gsap.matchMedia().add("(min-width: 861px)", () => {
    cards.forEach((card, i) => {
      const scale = 1;
      const y = 0;
      const bg = (i === 0)
        ? CARD_TOP_COLOR
        : STACK_COLORS[Math.min(i - 1, STACK_COLORS.length - 1)];
      gsap.set(card, { scale, y, backgroundColor: bg });
    });
  });

  let lastActive = -1;

  const timeline = gsap.timeline({
    scrollTrigger: {
      trigger: section,
      start: "top top",
      end: "+=" + SCROLL_END,
      scrub: 1.2,
      pin: true,
      pinSpacing: true,
      anticipatePin: 1,
      onUpdate: (self) => {
        const totalDur = timeline.duration();
        const animEnd = totalDur - INITIAL_DELAY - END_DELAY;
        let t = self.progress * totalDur - INITIAL_DELAY;
        t = Math.max(0, Math.min(t, animEnd));
        const animProgress = t / animEnd;
        const activeIndex = Math.round(animProgress * (TOTAL - 1));

        if (activeIndex !== lastActive) {
          lastActive = activeIndex;

          cards.forEach((card, i) => {
            if (i <= activeIndex) {
              gsap.to(card, { backgroundColor: CARD_TOP_COLOR, duration: 0.6 });
            } else {
              const ci = i - activeIndex - 1;
              gsap.to(card, {
                backgroundColor: STACK_COLORS[ci] || CARD_TOP_COLOR,
                duration: 0.6
              });
            }
          });

          setBg(activeIndex);
          setActiveThumb(activeIndex);
        }
      }
    }
  });

  gsap.from(stack, {
    scrollTrigger: {
      trigger: section,
      start: "top 85%",
      end: "top center",
      scrub: 3
    },
    y: "100%",
    duration: 4,
    ease: "power2.out"
  });

  timeline.to({}, { duration: INITIAL_DELAY });

  cards.forEach((card, i) => {
    if (i >= TOTAL - 1) return;
    const start = INITIAL_DELAY + i * CARD_DURATION;

    timeline.to(card, {
      y: "-=" + window.innerHeight,
      ease: "none",
      duration: CARD_DURATION
    }, start);

    if (cards[i + 1]) {
      timeline.to(cards[i + 1], {
        scale: 1, y: 0,
        ease: "none",
        duration: CARD_DURATION * 0.5
      }, start + CARD_DURATION * 0.25);
    }

    for (let j = i + 2; j < TOTAL; j++) {
      const scale = 1;
      const y = 0;
      timeline.to(cards[j], {
        scale, y,
        ease: "none",
        duration: CARD_DURATION * 0.5
      }, start + CARD_DURATION * 0.25);
    }
  });

  timeline.to({}, { duration: END_DELAY });

  if (navWidget) {
    ScrollTrigger.create({
      trigger: section,
      start: "top top",
      end: "+=" + SCROLL_END,
      onToggle: (self) => {
        gsap.to(navWidget, {
          opacity: self.isActive ? 1 : 0,
          visibility: self.isActive ? "visible" : "hidden",
          pointerEvents: self.isActive ? "auto" : "none",
          duration: 0.3
        });
      }
    });
  }

  navThumbs.forEach((thumb, index) => {
    thumb.addEventListener("click", (e) => {
      e.preventDefault();
      const st = timeline.scrollTrigger;
      if (!st) return;
      const totalDur = timeline.duration();
      const animDur = totalDur - INITIAL_DELAY - END_DELAY;
      const cardDur = animDur / (TOTAL - 1);
      const targetProgress = (index * cardDur + INITIAL_DELAY) / totalDur;
      const clamped = Math.max(0, Math.min(targetProgress, 1));
      const targetY = st.start + (st.end - st.start) * clamped;

      gsap.to(window, {
        duration: 1,
        scrollTo: { y: targetY, autoKill: false },
        ease: "power2.inOut"
      });
    });
  });
}


document.addEventListener("DOMContentLoaded", () => {
  if (typeof initShowcase === "function") initShowcase();
});